#
# Oracle 8.1.7's reply to OCI 9.2's READ of a 14-character temporary CLOB
# (#2850): the content's chunks ('temporary text', then the zero-length one),
# the RPA (the 86-byte locator echoed, the amount read, 14), then the 8i status.
# Captured 2026-11-27 with tcpdump on the 9i VM. The TTC payload, without the
# packet's header, as `hexdump -C` output; the offset column and the |ascii|
# gutter are ignored by tests.replay.parse_hexdump.
00000000  0e fe 0e 74 65 6d 70 6f  72 61 72 79 20 74 65 78  |...temporary tex|
00000010  74 00 08 00 54 00 01 02  08 00 03 00 01 00 00 00  |t...T...........|
00000020  00 00 00 00 00 00 01 00  01 00 0a 00 00 00 0a 00  |................|
00000030  00 00 00 13 73 ff c9 ec  5b 74 a0 00 00 00 00 00  |....s...[t......|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 0e 00 00 00 04 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 01 00 40 00  |..............@.|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 0a 00 00 01  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00                       |.........|
000000a9
