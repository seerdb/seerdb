#
# 11g's reply to the CLOB's (#2466): TTI_RPA, the new 40-byte locator in the 86
# bytes the request's took, the charset 873 and a ub8 of 1, then the status.
# Captured 2026-11-06 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8;
# OCILobCreateTemporary, OCIBindByPos and the like, called through ctypes) on
# Oracle 11g XE 11.2.0.2 with SERVER=POOLED, the DRCP pool started. The TTC
# payload, without the packet's header, as `hexdump -C` output; the offset
# column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 00 26 00 01 82 08 80  01 00 02 00 00 9f 08 2f  |..&............/|
00000010  00 00 00 00 01 03 69 00  0a 00 00 00 01 00 00 00  |......i.........|
00000020  00 dc fd 30 76 86 92 1a  ef 00 00 00 00 00 00 00  |...0v...........|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 69  03 01 00 00 00 00 00 00  |.......i........|
00000060  00 04 01 00 00 00 0a 00  01 01 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 0a 00 00 01 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00 20 f6 31 0a 00 00 00  |......... .1....|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 00 00 00 00  00                       |.........|
