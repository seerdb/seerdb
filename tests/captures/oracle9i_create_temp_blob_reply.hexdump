# Oracle 9.2.0.4's reply to seerdb's CREATE_TEMP of a BLOB on a thin OALL8 session
# (#2803), the locator offered 86 bytes: the locator (`00 54`, 84 bytes), the
# charset (1), the SCN slot (1), 0, the status.
# Captured 2026-11-27 through tools/capture_proxy.py. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 00 54 00 01 01 08 00  03 00 01 00 00 00 00 00  |..T.............|
00000010  00 00 00 00 02 00 00 00  0a 00 00 00 01 00 00 00  |................|
00000020  00 c5 6b 30 58 53 2a c5  22 00 00 00 00 00 00 00  |..k0XS*.".......|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 01  01 01 01 00 04 01 01 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 0b 00 01 01 00 00  00 00                    |..........|
0000007a
