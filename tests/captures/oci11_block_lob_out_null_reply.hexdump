#
# 11g's reply to `begin :1 := null; end;` with a CLOB OUT bind and its
# indicator (#2466): the value a ub4 0 and no locator, the indicator 0xFFFF.
# Captured 2026-11-06 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8;
# OCILobCreateTemporary, OCIBindByPos and the like, called through ctypes) on
# Oracle 11g XE 11.2.0.2 with SERVER=POOLED, the DRCP pool started. The TTC
# payload, without the packet's header, as `hexdump -C` output; the offset
# column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 01 05 93 01 00 00 00  00 00 01 00 00 00 00 00  |................|
00000010  00 00 10 53 4f a0 fd 7f  00 00 00 00 e8 07 00 00  |...SO...........|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000030  00 00 10 07 00 00 00 00  ff ff 08 06 00 90 09 75  |...............u|
00000040  00 00 00 00 00 01 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 04 01 00  |................|
00000060  00 00 06 00 01 01 00 00  00 00 00 00 00 00 00 01  |................|
00000070  00 00 00 2f 00 00 00 00  00 00 00 00 00 00 00 00  |.../............|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 06 00  |................|
00000090  00 01 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 20 f6 31  0a 00 00 00 00 00 00 00  |..... .1........|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 00                                    |.....|
