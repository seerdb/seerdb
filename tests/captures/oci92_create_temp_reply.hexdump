#
# The answer to it: the new locator in 86 bytes, then the status.
# Captured 2026-11-08 from a client net trace (TRACE_LEVEL_CLIENT 16) of an OCI
# 9.2 program (NLS_LANG AMERICAN_AMERICA.AL32UTF8) on the 9i bed itself, Oracle 9.2.0.4, x86-64 Linux.
# The TTC payload, without the packet's header, as `hexdump -C` output; the
# offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 00 54 00 01 02 08 00  03 00 01 00 00 00 00 00  |..T.............|
00000010  00 00 00 00 03 03 69 00  0a 00 00 00 01 00 00 00  |......i.........|
00000020  00 e5 2a 4d ce 60 f9 2c  2b 00 00 00 00 00 00 00  |..*M.`.,+.......|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 69  03 01 00 00 00 04 01 00  |.......i........|
00000060  00 00 01 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 0d 00 00 00  |................|
00000090  00 00 00 36 01 00 00 00  00 00 00 00 00 00 00 00  |...6............|
000000a0  00 00 00 80 d0 d4 03 00  00 00 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00                                          |...|
000000e3
