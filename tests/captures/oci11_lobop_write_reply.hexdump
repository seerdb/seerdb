#
# 11g's reply to it: TTI_RPA, the locator as the write left it (one byte
# differs from the one sent), the amount written, the status.
# Captured 2026-11-06 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux; OCILobGetLength, OCILobOpen and the
# like, called through ctypes) on Oracle 11g XE 11.2.0.2 with SERVER=POOLED,
# the DRCP pool started. The TTC payload, without the packet's header, as
# `hexdump -C` output; the offset column and the |ascii| gutter are ignored by
# tests.replay.parse_hexdump.
00000000  08 00 54 00 01 02 0c 80  00 00 02 00 00 00 01 00  |..T.............|
00000010  00 00 57 62 e7 00 01 e7  d4 00 01 e7 d3 00 02 00  |..Wb............|
00000020  02 03 69 00 01 00 68 00  65 00 6c 00 6c 00 6f 00  |..i...h.e.l.l.o.|
00000030  20 00 00 00 00 00 73 55  c5 00 00 00 04 00 0d 00  | .....sU........|
00000040  00 07 c6 00 c0 0c 3e 04  72 13 00 00 00 00 01 e7  |......>.r.......|
00000050  d3 01 00 01 53 00 00 05  00 00 00 00 00 00 00 04  |....S...........|
00000060  02 00 00 00 22 00 01 01  00 00 00 00 00 00 00 00  |...."...........|
00000070  00 00 00 00 00 00 00 00  00 00 00 d3 e7 01 00 04  |................|
00000080  00 00 00 53 01 00 00 00  00 00 00 00 00 00 00 00  |...S............|
00000090  22 00 00 01 00 00 00 00  00 00 00 00 00 00 00 00  |"...............|
000000a0  00 00 00 00 00 00 00 20  f6 31 0a 00 00 00 00 00  |....... .1......|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 00 00 00                              |.......|
000000e7
