#
# 11g's reply to an executemany of three rows into a pooled session's
# `insert into pyo_drcp_am values (:1, :2, :3)` (#2466): the return parameters,
# the OER (3 rows) and the last row's rowid.
# Captured 2026-11-05 through tools/capture_proxy.py: seerdb's pooled session on
# Oracle 11g XE 11.2.0.2, the DRCP pool started, its first statement after the
# login. The TTC payload, without the packet's header, as `hexdump -C` output;
# the offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 06 00 fd 21 72 00 00  00 00 00 04 00 00 00 01  |....!r..........|
00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 04 02 00 00 00  08 00 01 03 00 00 00 00  |................|
00000030  00 00 00 00 00 04 00 0c  00 02 00 00 00 00 00 8d  |................|
00000040  e0 01 00 04 00 00 00 56  01 00 00 02 00 00 00 00  |.......V........|
00000050  00 00 00 00 0a 00 00 03  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 20 f6 31 0a 00  |........... .1..|
00000070  00 00 00 0d 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00 00 00 0d 00 0d 01 00  |................|
000000b0  01 e0 8d 00 04 00 00 01  56 00 02                 |........V..|
000000bb
