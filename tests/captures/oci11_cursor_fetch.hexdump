#
# sqlplus 11.2's fetch from that cursor (#2466): an OALL8 with no SQL, cursor 3,
# options FETCH, max_long 42 (the widest column's buffer and one), al8i4[1] 15
# rows and [7] SELECT. At offset 131 sqlplus leaves its own address in a
# pointer field (al8txn), where seerdb sends the indicator.
# Captured 2026-11-06 through tools/capture_proxy.py: sqlplus 11.2 (instant
# client 11.2, x86-64 Linux) on Oracle 11g XE 11.2.0.2 with SERVER=POOLED, the
# DRCP pool started. The TTC payload, without the packet's header, as
# `hexdump -C` output; the offset column and the |ascii| gutter are ignored by
# tests.replay.parse_hexdump.
00000000  03 5e 16 40 00 00 00 03  00 00 00 00 00 00 00 00  |.^.@............|
00000010  00 00 00 00 00 00 00 00  00 00 00 fe ff ff ff ff  |................|
00000020  ff ff ff 0d 00 00 00 00  00 00 00 fe ff ff ff ff  |................|
00000030  ff ff ff fe ff ff ff ff  ff ff ff 00 00 00 00 00  |................|
00000040  00 00 00 2a 00 00 00 00  00 00 00 00 00 00 00 00  |...*............|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 fe ff ff ff ff  ff ff ff 00 00 00 00 00  |................|
00000070  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000080  ff ff ff e8 ba c8 26 00  00 00 00 00 00 00 00 00  |......&.........|
00000090  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
000000a0  ff ff ff 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 0f  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 01  |................|
000000e0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000f0  00 00 00 00 00 00 00                              |.......|
