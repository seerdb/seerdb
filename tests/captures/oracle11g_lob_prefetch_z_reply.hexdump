00000010  00 01 02 01 01 00 00 00  00 00 04 01 02 01 14 01  |................|
00000020  01 02 05 7b 00 00 01 02  00 03 00 00 00 00 00 03  |...{............|
00000030  04 b1 eb 01 04 00 02 02  d4 00 00 00 11 00 01 01  |................|
00000040  00 00 00 00 19 4f 52 41  2d 30 31 34 30 33 3a 20  |.....ORA-01403: |
00000050  6e 6f 20 64 61 74 61 20  66 6f 75 6e 64 0a        |no data found.|
