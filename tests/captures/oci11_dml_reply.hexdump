#
# 11g's reply to sqlplus's `insert into pyo_drcp_probe values (1, 'one')`
# (#2466): the status frame (its DML mark 1), the OER (cursor 3, 1 row) and the
# 16 bytes behind a DML's OER.
# Captured 2026-11-05 through tools/capture_proxy.py: sqlplus 11.2 (instant
# client 11.2, x86-64 Linux) running statements on Oracle 11g XE 11.2.0.2 with
# SERVER=POOLED, the DRCP pool started. The TTC payload, without the packet's
# header, as `hexdump -C` output; the offset column and the |ascii| gutter are
# ignored by tests.replay.parse_hexdump.
00000000  08 06 00 a2 6f 70 00 00  00 00 00 03 00 00 00 01  |....op..........|
00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 04 02 00 00 00  1d 00 01 01 00 00 00 00  |................|
00000030  00 00 00 00 00 03 00 0c  00 02 00 00 00 00 00 6c  |...............l|
00000040  d5 01 00 04 00 00 00 56  01 00 00 00 00 00 00 00  |.......V........|
00000050  00 00 00 00 1e 00 00 01  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 20 f6 31 0a 00  |........... .1..|
00000070  00 00 00 0d 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00 00 00 0d 00 0d 01 00  |................|
000000b0  01 d5 6c 00 04 00 00 01  56 00 00                 |..l.....V..|
000000bb
