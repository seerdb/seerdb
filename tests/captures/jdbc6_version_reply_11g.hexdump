00000020  64 69 74 69 6f 6e 20 52  65 6c 65 61 73 65 20 31  |dition Release 1|
00000030  31 2e 32 2e 30 2e 32 2e  30 20 2d 20 36 34 62 69  |1.2.0.2.0 - 64bi|
00000040  74 20 50 72 6f 64 75 63  74 69 6f 6e 04 0b 20 02  |t Production.. .|
