00000040  4e 9a dd 59 4d e0 60 a8  c0 96 00 5f 67 00 00 00  |N..YM.`...._g...|
00000050  00 00 00 00 00 00 00 00  00 00 01 00 01 00 00 00  |................|
00000060  00 00 00 00 00 00 00 0c  00 00 00 01 00 0c 84 01  |................|
00000070  0c 02 c1 2b 05 68 65 6c  6c 6f 08 06 00 7b d3 84  |...+.hello...{..|
