#
# OCI 11.2's OCI_ATTR_MODULE of SOLOMOD (the action goes with it, empty), piggybacked ahead of the next execute: func 135, thin's
# fields at OCI's widths. Non-null pointers of attributes this call didn't
# change are the client's heap addresses, and the ub2 at 0x59 is OCI's execution
# context sequence; the server ignores both.
# Captured 2026-11-08 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux; OCIAttrSet on the session handle) on
# Oracle 11g XE 11.2.0.2. The TTC payload, without the packet's header, as
# `hexdump -C` output; the offset column and the |ascii| gutter are ignored by
# tests.replay.parse_hexdump.
00000000  11 87 07 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000010  00 00 00 18 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 00 00 00 00 00  00 00 00 fe ff ff ff ff  |................|
00000030  ff ff ff 15 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 04 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 07 53 4f 4c 4f  |............SOLO|
00000090  4d 4f 44                                          |MOD|
00000093
