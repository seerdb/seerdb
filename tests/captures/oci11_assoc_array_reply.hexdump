#
# The reply to it: the IN OUT array's count and elements, then :n.
# Captured 2026-11-08 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux; OCIBindByName with maxarr_len and curelep)
# on Oracle 11g XE 11.2.0.2, of BEGIN zz_probe_arr.go(:a, :s, :n); END; with :a
# a NUMBER array IN (10, 20, 30), :s a VARCHAR2 array IN OUT ('ab', 'cde') and :n
# a NUMBER OUT. The TTC payload, without the packet's header, as `hexdump -C`
# output; the offset column and the |ascii| gutter are ignored by
# tests.replay.parse_hexdump.
00000000  0b 01 05 93 03 00 00 00  00 00 01 00 00 00 00 00  |................|
00000010  00 00 30 0b b1 27 fe 7f  00 00 00 00 e8 07 00 00  |..0..'..........|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 9c 7f  |................|
00000030  00 00 20 30 10 07 03 00  00 00 03 61 62 5a 00 00  |.. 0.......abZ..|
00000040  04 63 64 65 5a 00 00 03  6e 65 77 00 00 02 c1 3d  |.cdeZ...new....=|
00000050  08 06 00 6c eb 89 00 00  00 00 00 03 00 00 00 00  |...l............|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 04 01 00 00 00  08 00 01 01 00 00 00 00  |................|
00000080  00 00 00 00 00 03 00 00  00 2f 00 00 00 00 00 00  |........./......|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 09 00 00 01  00 00 00 36 01 00 00 00  |...........6....|
000000b0  00 00 00 00 00 00 00 00  00 00 00 20 f6 31 0a 00  |........... .1..|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
