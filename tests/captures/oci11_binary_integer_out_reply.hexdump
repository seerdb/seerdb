#
# 11g's reply to it: the value comes back as the NUMBER 2.9 (03 c1 03 5b), and
# OCI truncates it to the integer 2 on the client.
# Captured 2026-11-08 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8; OCIBindByPos
# of an SQLT_INT bind of 4 bytes, called through ctypes) on Oracle 11g XE
# 11.2.0.2, a DEDICATED session. The TTC payload, without the packet's header,
# as `hexdump -C` output; the offset column and the |ascii| gutter are ignored
# by tests.replay.parse_hexdump.
00000000  0b 01 05 93 01 00 00 00  00 00 01 00 00 00 00 00  |................|
00000010  00 00 10 76 67 b2 ff 7f  00 00 00 00 e8 07 00 00  |...vg...........|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 b6 7f  |................|
00000030  00 00 10 07 03 c1 03 5b  00 00 08 06 00 1e ac 85  |.......[........|
00000040  00 00 00 00 00 02 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 01  00 00 00 00 00 0b 00 00  |................|
00000060  00 0b 80 00 00 00 3d 3c  3c 80 00 00 00 a3 00 00  |......=<<.......|
00000070  00 00 00 04 01 00 00 00  04 00 01 01 00 00 00 00  |................|
00000080  00 00 00 00 00 02 00 00  00 2f 00 00 00 00 00 00  |........./......|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 05 00 00 01  00 00 00 36 01 00 00 00  |...........6....|
000000b0  00 00 00 00 00 00 00 00  00 00 00 20 f6 31 0a 00  |........... .1..|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000f0  00 00 00 00 00 00 00 00  00 00 00                 |...........|
