#
# OCI 11.2's execute of `select 1 from dual` on 10g (#2518), a define fetching one
# row: OALL8's narrow head (lengths 4 bytes), 4 zeros and two indicators, the SQL
# with its length declared in bytes, and the 13 ub4s of al8i4.
# Captured 2026-11-08 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8, called
# through ctypes) on Oracle 10g 10.2.0.5, a dedicated session. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column and the
# |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 5e 05 61 80 00 00 00  00 00 00 fe ff ff ff ff  |.^.a............|
00000010  ff ff ff 12 00 00 00 fe  ff ff ff ff ff ff ff 0d  |................|
00000020  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000030  ff ff ff 00 00 00 00 01  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 fe ff ff ff ff  ff ff ff 00 00 00 00 00  |................|
00000060  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000070  ff ff ff fe ff ff ff ff  ff ff ff 00 00 00 00 00  |................|
00000080  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000090  ff ff ff 12 73 65 6c 65  63 74 20 31 20 66 72 6f  |....select 1 fro|
000000a0  6d 20 64 75 61 6c 01 00  00 00 00 00 00 00 00 00  |m dual..........|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
