#
# OCI 9.2's OCITransStart of a new branch (B), Oracle 9.2.0.4 (#2807).
# Captured 2026-11-26 from an OCI 9.2 program (OCITransStart, OCITransDetach, OCITransPrepare,
# OCITransCommit and OCITransRollback, with XIDs of format 2807, gtrid
# 'gtrid' and a letter, bqual 'bq' and the same letter) run on the 9i VM
# (x86-64 Linux), under tcpdump.
# The TTC payload, without the packet's header, as `hexdump -C` output; the
# offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 67 0d 01 00 00 00 00  00 00 00 00 00 00 00 00  |.g..............|
00000010  00 00 00 00 00 00 00 f7  0a 00 00 06 00 00 00 03  |................|
00000020  00 00 00 08 b5 51 00 00  00 00 00 80 00 00 00 01  |.....Q..........|
00000030  00 00 00 3c 00 00 00 00  00 00 00 ec 10 51 00 00  |...<.........Q..|
00000040  00 00 00 28 b4 51 00 00  00 00 00 4e f9 ff bf 7f  |...(.Q.....N....|
00000050  00 00 00 67 74 72 69 64  42 62 71 42 00 00 00 00  |...gtridBbqB....|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00                              |.......|
