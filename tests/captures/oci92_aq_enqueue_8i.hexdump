# OCI 9.2's AQ enqueue (OCIAQEnq, func 121) to Oracle 8.1.7 (#2805):
# RAW queue PYO_AQ_OCI, payload 'hello AQ', priority 7, expiration 3600,
# correlation 'CORR1'.
# Captured 2026-11-26 through tcpdump on the 9i VM. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 79 0a 01 0a 00 00 00  07 00 00 00 00 00 00 00  |.y..............|
00000010  10 0e 00 00 05 00 00 00  05 43 4f 52 52 31 00 00  |.........CORR1..|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 04 00  |................|
00000030  00 00 16 00 00 00 00 00  00 00 00 40 00 00 00 00  |...........@....|
00000040  00 00 00 00 00 41 00 00  00 00 00 01 00 00 00 01  |.....A..........|
00000050  00 42 00 00 00 00 00 00  00 00 00 45 00 00 00 00  |.B.........E....|
00000060  00 00 02 00 00 00 00 00  00 00 00 00 00 00 00 01  |................|
00000070  10 00 00 00 01 00 00 01  08 00 00 00 01 10 00 00  |................|
00000080  00 00 00 00 00 0a 50 59  4f 5f 41 51 5f 4f 43 49  |......PYO_AQ_OCI|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 17  |................|
000000a0  68 65 6c 6c 6f 20 41 51                           |hello AQ|
000000a8
