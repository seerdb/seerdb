#
# 11g's reply to it (#2466): a bare TTI_STA, call status 1 and the session's
# sequence.
# Captured 2026-11-06 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8; OCIPing and
# OCIStmtExecute, called through ctypes) on Oracle 11g XE 11.2.0.2 with
# SERVER=POOLED, the DRCP pool started. The TTC payload, without the packet's
# header, as `hexdump -C` output; the offset column and the |ascii| gutter are
# ignored by tests.replay.parse_hexdump.
00000000  09 01 00 00 00 06 00                              |.......|
00000007
