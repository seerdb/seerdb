#
# 11g's reply to `insert into pyo_drcp_iot values (1, 'a')`, an index-organized
# table (#2466): behind the OER the touched row's rowid as a UROWID cell, a
# logical one (*BAEAJrMCwQL+).
# Captured 2026-11-05 through tools/capture_proxy.py: seerdb's pooled session on
# Oracle 11g XE 11.2.0.2, the DRCP pool started, its first statement after the
# login. The TTC payload, without the packet's header, as `hexdump -C` output;
# the offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 06 00 b7 c5 70 00 00  00 00 00 06 00 00 00 01  |.....p..........|
00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 04 02 00 00 00  08 00 01 01 00 00 00 00  |................|
00000030  00 00 00 00 00 06 00 0c  00 02 00 00 00 00 00 c1  |................|
00000040  d8 01 00 04 00 00 00 b3  26 00 00 00 00 00 00 00  |........&.......|
00000050  00 00 00 00 0a 00 00 01  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 20 f6 31 0a 00  |........... .1..|
00000070  00 00 00 0a 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 00  00 00 00 0a 00 0a 02 04  |................|
000000b0  01 00 26 b3 02 c1 02 fe                           |..&.....|
000000b8
