#
# OCI 9.2's INSERT INTO zz_null9 VALUES (:1), :1 a CLOB bound with indicator -1,
# committed on success.
# Captured 2026-11-08 from a client net trace (TRACE_LEVEL_CLIENT 16) of an OCI
# 9.2 program on the 9i bed itself, Oracle 9.2.0.4, x86-64 Linux.
# The TTC payload, without the packet's header, as `hexdump -C` output; the
# offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 5e 13 29 81 00 00 00  00 00 00 18 6c 53 00 00  |.^.)........lS..|
00000010  00 00 00 20 00 00 00 00  00 00 00 0c 23 53 00 00  |... ........#S..|
00000020  00 00 00 0c 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000030  00 00 00 3c 23 53 00 00  00 00 00 00 00 00 00 01  |...<#S..........|
00000040  00 00 00 00 00 00 00 00  00 00 00 b0 6c 53 00 00  |............lS..|
00000050  00 00 00 01 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 3e 23 53 00 00  |...........>#S..|
00000080  00 00 00 b0 6c 53 00 00  00 00 00 00 00 00 00 00  |....lS..........|
00000090  00 00 00 20 49 4e 53 45  52 54 20 49 4e 54 4f 20  |... INSERT INTO |
000000a0  7a 7a 5f 6e 75 6c 6c 39  20 56 41 4c 55 45 53 20  |zz_null9 VALUES |
000000b0  28 3a 31 29 01 00 00 00  01 00 00 00 00 00 00 00  |(:1)............|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  04 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 01 70 01 00  00 20 00 00 00 00 00 00  |.....p... ......|
000000f0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000100  00 1f 00 01 00 00 00 00  00 00 00 00 00 07 00 00  |................|
