# OCI 9.2's AQ dequeue (OCIAQDeq, func 122) to Oracle 8.1.7 (#2805): queue
# PYO_AQ_OCI, wait 5 seconds, correlation 'CORR1'.
# Captured 2026-11-26 through tcpdump on the 9i VM. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 7a 0c 01 0a 00 00 00  00 01 00 01 01 00 00 00  |.z..............|
00000010  00 03 00 00 00 03 00 00  00 02 00 00 00 05 00 00  |................|
00000020  00 00 00 00 00 00 01 05  00 00 00 01 10 00 00 00  |................|
00000030  01 00 01 01 10 00 00 00  00 00 00 00 0a 50 59 4f  |.............PYO|
00000040  5f 41 51 5f 4f 43 49 05  43 4f 52 52 31 00 00 00  |_AQ_OCI.CORR1...|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 17           |.............|
0000005d
