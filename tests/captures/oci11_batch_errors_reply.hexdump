#
# 11g's reply to the same insert of rows 4, 1 and 5 in batch-errors mode, row 1
# a duplicate key (#2466): the OER with ORA-24381 and 2 rows applied, its three
# batch-error slots naming one error each; behind it the arrays (code 1, row 1,
# the ORA-00001 message), then ORA-24381's own message.
# Captured 2026-11-05 through tools/capture_proxy.py: seerdb's pooled session on
# Oracle 11g XE 11.2.0.2, the DRCP pool started, its first statement after the
# login. The TTC payload, without the packet's header, as `hexdump -C` output;
# the offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  04 02 00 00 00 0c 00 00  02 00 00 00 3d 5f 00 00  |............=_..|
00000010  00 00 03 00 00 00 02 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000030  00 0e 00 00 03 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  20 f6 31 0a 00 00 00 00  |........ .1.....|
00000050  00 00 00 00 00 00 00 00  b8 32 3b 4e b9 7f 00 00  |.........2;N....|
00000060  01 00 00 00 00 00 00 00  c0 32 3b 4e b9 7f 00 00  |.........2;N....|
00000070  01 00 00 00 00 00 00 00  58 32 3b 4e b9 7f 00 00  |........X2;N....|
00000080  01 00 00 00 00 00 00 00  01 00 01 00 00 00 39 00  |..............9.|
00000090  00 00 39 4f 52 41 2d 30  30 30 30 31 3a 20 75 6e  |..9ORA-00001: un|
000000a0  69 71 75 65 20 63 6f 6e  73 74 72 61 69 6e 74 20  |ique constraint |
000000b0  28 50 59 4f 2e 53 59 53  5f 43 30 30 31 30 32 32  |(PYO.SYS_C001022|
000000c0  33 29 20 76 69 6f 6c 61  74 65 64 0a 00 00 00 00  |3) violated.....|
000000d0  00 00 21 4f 52 41 2d 32  34 33 38 31 3a 20 65 72  |..!ORA-24381: er|
