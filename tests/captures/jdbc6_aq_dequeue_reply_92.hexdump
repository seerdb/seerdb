# Oracle 9.2.0.4's reply to JDBC thin 11.2's (ojdbc6) AQ dequeue (#2805), the
# message enqueued in jdbc6_aq_enqueue_92.hexdump.
# Captured 2026-11-26 through tools/capture_proxy.py. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 01 01 01 07 00 02 0e  10 01 05 05 43 4f 52 52  |............CORR|
00000010  31 00 00 00 01 07 31 78  7e 0b 1a 0f 25 33 00 01  |1.....1x~...%3..|
00000020  08 00 00 00 8f b3 50 b8  7d d6 03 00 00 00 00 c0  |......P.}.......|
00000030  70 da 03 00 00 00 00 a8  00 00 00 00 00 00 00 43  |p..............C|
00000040  4f 52 52 31 00 00 00 00  01 04 16 00 00 01 40 00  |ORR1..........@.|
00000050  00 01 41 00 00 01 42 00  00 01 45 00 00 00 00 00  |..A...B...E.....|
00000060  01 0c 02 04 01 0c 00 00  00 08 68 65 6c 6c 6f 20  |..........hello |
00000070  41 51 09 01 06                                    |AQ...|
