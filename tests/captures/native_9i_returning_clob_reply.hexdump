#
# Oracle 9.2.0.4's reply to seerdb's native-form INSERT ... RETURNING c INTO :b
# (#2839), its PL/SQL wrap's three binds: the RPA's first value, the SCN, is
# `.. 04 03 00 00 00 00`, which a scan for the status took for it.
# Captured 2026-11-26 through tools/capture_proxy.py. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 01 05 00 03 00 00 00  01 00 00 00 00 00 00 00  |................|
00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000030  00 00 20 10 10 07 56 00  00 00 56 00 54 00 01 02  |.. ...V...V.T...|
00000040  0c 00 00 00 01 00 00 00  01 00 00 00 2f 3d f5 00  |............/=..|
00000050  08 bb 00 00 08 ba ff 00  02 00 02 00 1f 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 03  |................|
00000070  04 e9 32 00 00 00 09 00  09 00 00 d7 ff 00 80 0e  |..2.............|
00000080  7e 06 18 2a 00 00 00 00  08 ba ff 00 40 b8 da 00  |~..*........@...|
00000090  02 00 00 02 c1 02 00 00  00 00 08 05 00 32 e9 04  |.............2..|
000000a0  03 00 00 00 00 07 00 00  00 01 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 04 02 00  00 00 01 01 00 00 00 00  |................|
000000c0  00 00 00 00 00 07 00 00  00 2f 00 00 00 00 00 ff  |........./......|
000000d0  ba 08 00 01 00 00 00 da  b8 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00 0d 00 00 01  00 00 00 36 01 00 00 00  |...........6....|
000000f0  00 00 00 00 00 00 00 00  00 00 00 80 d0 d4 03 00  |................|
00000100  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000110  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000120  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000130  00 00 00 00 00 00 00 00  00 00 00                 |...........|
0000013b
