#
# sqlplus 11.2's OSESSKEY in the native form (#2466): _AUTH_HEAD at OCI's
# widths, every length declared at three bytes a character, then five pairs
# (AUTH_TERMINAL, AUTH_PROGRAM_NM, AUTH_MACHINE, AUTH_PID, AUTH_SID).
# Captured 2026-11-05 through tools/capture_proxy.py: sqlplus 11.2 (instant
# client 11.2, x86-64 Linux) logging in to Oracle 11g XE 11.2.0.2 with
# SERVER=POOLED, the DRCP pool started. The TTC payload, without the packet's
# header, as `hexdump -C` output; the offset column and the |ascii| gutter are
# ignored by tests.replay.parse_hexdump.
00000000  03 76 02 fe ff ff ff ff  ff ff ff 09 00 00 00 01  |.v..............|
00000010  00 00 00 fe ff ff ff ff  ff ff ff 05 00 00 00 00  |................|
00000020  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000030  ff ff ff 03 70 79 6f 27  00 00 00 0d 41 55 54 48  |....pyo'....AUTH|
00000040  5f 54 45 52 4d 49 4e 41  4c 00 00 00 00 00 00 00  |_TERMINAL.......|
00000050  00 2d 00 00 00 0f 41 55  54 48 5f 50 52 4f 47 52  |.-....AUTH_PROGR|
00000060  41 4d 5f 4e 4d 51 00 00  00 1b 73 71 6c 70 6c 75  |AM_NMQ....sqlplu|
00000070  73 40 66 69 72 65 66 6c  79 20 28 54 4e 53 20 56  |s@firefly (TNS V|
00000080  31 2d 56 33 29 00 00 00  00 24 00 00 00 0c 41 55  |1-V3)....$....AU|
00000090  54 48 5f 4d 41 43 48 49  4e 45 15 00 00 00 07 66  |TH_MACHINE.....f|
000000a0  69 72 65 66 6c 79 00 00  00 00 18 00 00 00 08 41  |irefly.........A|
000000b0  55 54 48 5f 50 49 44 0f  00 00 00 05 38 38 36 34  |UTH_PID.....8864|
000000c0  35 00 00 00 00 18 00 00  00 08 41 55 54 48 5f 53  |5.........AUTH_S|
000000d0  49 44 0f 00 00 00 05 70  65 74 72 6f 00 00 00 00  |ID.....petro....|
000000e0
