#
# 11g's reply to `begin open :1 for select 1 from dual; close :1; end;` with a
# REF CURSOR bound (#2466): the cursor cell with no columns -- the lead byte,
# a zero row size and count, the trailer without the column array's lead byte,
# a cursor id -- its indicator, then the status.
# Captured 2026-11-06 through tools/capture_proxy.py: seerdb's pooled session on
# Oracle 11g XE 11.2.0.2, the DRCP pool started. The TTC payload, without the
# packet's header, as `hexdump -C` output; the offset column and the |ascii|
# gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 01 05 46 01 00 00 00  00 00 01 00 00 00 00 00  |...F............|
00000010  00 00 b0 f6 d4 f8 fe 7f  00 00 00 00 e8 07 00 00  |................|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 59 7f  |..............Y.|
00000030  00 00 30 07 4c 00 00 00  00 00 00 00 00 07 00 00  |..0.L...........|
00000040  00 07 78 7e 0b 06 0e 13  02 00 00 00 00 00 00 00  |..x~............|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 08 06 00 e4 fa  75 00 00 00 00 00 03 00  |........u.......|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 04 01  00 00 00 05 00 01 01 00  |................|
00000090  00 00 00 00 00 00 00 00  03 00 00 00 2f 00 00 00  |............/...|
000000a0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 00 00 07  00 00 01 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 20 f6  |.............. .|
000000d0  31 0a 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |1...............|
000000e0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000f0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000100  00 00 00 00 00 00 00 00  00 00 00 00 00 00        |..............|
0000010e
