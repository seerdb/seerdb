00000040  00 00 00 00 00 00 00 00  20 f6 31 0a 00 00 00 00  |........ .1.....|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  28 4f 52 41 2d 30 30 39  |........(ORA-009|
00000090  34 32 3a 20 74 61 62 6c  65 20 6f 72 20 76 69 65  |42: table or vie|
