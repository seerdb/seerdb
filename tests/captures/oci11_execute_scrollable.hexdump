#
# OCI 11.2's scrollable execute (#2466): al8i4[9] SCROLLABLE | NO_CANCEL_ON_EOF
# (0x82), [10] CURRENT and [11] row 1. OCI defines its column, so the execute
# carries a define and the DEFINE option, which seerdb's leaves out.
# Captured 2026-11-06 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8;
# OCIStmtExecute with OCI_STMT_SCROLLABLE_READONLY and OCIStmtFetch2, called
# through ctypes) on Oracle 11g XE 11.2.0.2 with SERVER=POOLED, the DRCP pool
# started, scrolling `select level n from dual connect by level <= 10`. The TTC
# payload, without the packet's header, as `hexdump -C` output; the offset
# column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 5e 06 71 80 04 00 00  00 00 00 fe ff ff ff ff  |.^.q............|
00000010  ff ff ff 2f 00 00 00 00  00 00 00 fe ff ff ff ff  |.../............|
00000020  ff ff ff 0d 00 00 00 00  00 00 00 fe ff ff ff ff  |................|
00000030  ff ff ff fe ff ff ff ff  ff ff ff 00 00 00 00 01  |................|
00000040  00 00 00 04 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 fe ff ff ff ff  ff ff ff 00 00 00 00 00  |................|
00000070  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
00000080  ff ff ff fe ff ff ff ff  ff ff ff 01 00 00 00 00  |................|
00000090  00 00 00 fe ff ff ff ff  ff ff ff fe ff ff ff ff  |................|
000000a0  ff ff ff 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 2f 73 65 6c 65  63 74 20 6c 65 76 65 6c  |.../select level|
000000d0  20 6e 20 66 72 6f 6d 20  64 75 61 6c 20 63 6f 6e  | n from dual con|
000000e0  6e 65 63 74 20 62 79 20  6c 65 76 65 6c 20 3c 3d  |nect by level <=|
000000f0  20 31 30 01 00 00 00 00  00 00 00 00 00 00 00 00  | 10.............|
00000100  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 01  |................|
