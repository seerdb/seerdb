#
# 11g's reply to `BEGIN UPDATE pyo_drcp_r SET n = :1 WHERE id = :2 RETURNING n
# INTO :3; END;` when no row matched (#2466): the bind prompt (directions 0x20
# 0x20 0x10), TTI_RXD and the OUT value as a NULL row cell's 0xFF with the return
# code 3105 (`ff 21 0c`), then the status.
# Captured 2026-11-05 through tools/capture_proxy.py: seerdb's pooled session on
# Oracle 11g XE 11.2.0.2, the DRCP pool started, its first statement after the
# login. The TTC payload, without the packet's header, as `hexdump -C` output;
# the offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 01 05 92 03 00 00 00  00 00 01 00 00 00 00 00  |................|
00000010  00 00 50 e3 49 41 fe 7f  00 00 00 00 e8 07 00 00  |..P.IA..........|
00000020  00 00 00 00 00 00 00 00  00 00 00 00 00 00 21 7f  |..............!.|
00000030  00 00 20 20 10 07 ff 21  0c 08 06 00 79 92 71 00  |..  ...!....y.q.|
00000040  00 00 00 00 04 00 00 00  01 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 04 02 00 00  |................|
00000060  00 0c 00 01 01 00 00 00  00 00 00 00 00 00 04 00  |................|
00000070  00 00 2f 00 00 00 00 00  e6 dd 01 00 04 00 00 00  |../.............|
00000080  d7 21 00 00 00 00 00 00  00 00 00 00 00 0e 00 00  |.!..............|
00000090  01 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 20 f6 31 0a  00 00 00 00 00 00 00 00  |.... .1.........|
000000b0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000c0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000d0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000e0  00 00 00 00                                       |....|
000000e4
