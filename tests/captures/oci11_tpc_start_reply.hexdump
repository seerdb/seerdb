#
# OCI 11.2's answer to OCITransStart, to Oracle 11g XE 11.2.0.2, the piggybacks ahead of it left out.
# Captured 2026-11-08 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux; OCITransStart and the rest, with an
# XID of format 1001, gtrid '1tr' or its digit's, bqual 'bql'). The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column and the
# |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 00 00 00 00 a8 00 00  00 00 00 00 00 00 00 e9  |................|
00000010  03 00 00 00 00 00 00 03  00 00 00 00 00 00 00 03  |................|
00000020  00 00 00 00 00 00 00 31  74 72 62 71 6c 00 00 00  |.......1trbql...|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000090  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
000000a0  00 00 00 00 00 00 00 77  00 00 00 00 00 00 00 09  |.......w........|
000000b0  03 00 00 00 06 00                                 |......|
000000b6
