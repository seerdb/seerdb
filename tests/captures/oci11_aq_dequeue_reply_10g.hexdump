# Oracle 10.2.0.5's reply to OCI 11.2's AQ dequeue (#2805): the message
# 'hello AQ' with no properties set, so an expiration of -1.
# Captured 2026-11-26 through tools/capture_proxy.py. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 01 00 00 00 00 00 00  00 00 00 ff ff ff ff 00  |................|
00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 01  |................|
00000020  00 00 00 07 78 7e 0b 1a  10 12 2d 00 00 00 00 04  |....x~....-.....|
00000030  00 00 00 16 00 00 00 00  00 00 00 00 40 00 00 00  |............@...|
00000040  00 00 00 00 00 00 41 00  00 00 00 00 00 00 00 00  |......A.........|
00000050  42 00 00 00 00 00 00 00  00 00 45 00 00 00 00 00  |B.........E.....|
00000060  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000070  00 00 00 00 00 00 00 00  00 00 00 00 0c 00 00 00  |................|
00000080  01 04 0c 00 00 00 08 68  65 6c 6c 6f 20 41 51 61  |.......hello AQa|
00000090  2f 9b 6d 4d cf 48 e4 e0  60 a8 c0 96 00 7e b1 09  |/.mM.H..`....~..|
000000a0  02 00 00 00 0d 00                                 |......|
