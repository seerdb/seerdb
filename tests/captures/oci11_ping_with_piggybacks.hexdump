#
# OCI 11.2's OCIPing after an OCIAppCtxSet of ATTR1 = 'PING' (#2466): the
# context's piggyback, then the close of the cursor the last query left, then
# the ping, each taking its sequence number in that order.
# Captured 2026-11-07 through tools/capture_proxy.py: an OCI 11.2 program
# (instant client 11.2, x86-64 Linux, the client charset AL32UTF8; OCIAppCtxSet,
# OCIAppCtxClearAll and OCIPing called through ctypes) on Oracle 11g XE 11.2.0.2
# with SERVER=POOLED, the DRCP pool started. The TTC payload, without the
# packet's header, as `hexdump -C` output; the offset column and the |ascii|
# gutter are ignored by tests.replay.parse_hexdump.
00000000  11 9a 14 fe ff ff ff ff  ff ff ff 0d 00 00 00 00  |................|
00000010  00 00 00 fe ff ff ff ff  ff ff ff 01 00 00 00 09  |................|
00000020  00 00 00 00 00 00 00 00  00 00 00 0d 43 4c 49 45  |............CLIE|
00000030  4e 54 43 4f 4e 54 45 58  54 05 00 00 00 05 41 54  |NTCONTEXT.....AT|
00000040  54 52 31 04 00 00 00 04  50 49 4e 47 00 00 00 00  |TR1.....PING....|
00000050  11 69 15 fe ff ff ff ff  ff ff ff 01 00 00 00 00  |.i..............|
00000060  00 00 00 01 00 00 00 03  93 16                    |..........|
0000006a
