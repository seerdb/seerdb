#
# Oracle 8.1.7's reply to OCI 9.2's CREATE OR REPLACE PROCEDURE that
# compiles clean (#2804): its status, warning flags 0.
# Captured 2026-11-26 through tcpdump on the 9i VM. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  08 04 00 5a de 36 00 00  00 00 00 01 00 00 00 02  |...Z.6..........|
00000010  00 00 00 00 00 00 00 04  00 00 00 00 00 00 00 00  |................|
00000020  00 00 01 00 00 00 18 00  40 00 00 00 00 00 00 00  |........@.......|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 05 00  |................|
00000040  00 01 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00                                          |...|
00000053
