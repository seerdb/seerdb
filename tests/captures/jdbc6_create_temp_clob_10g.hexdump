# JDBC thin 11.2 (ojdbc6) making a temporary CLOB (createTemporary, session duration)
# on 10.2.0.5 (#2803): the LOBOPS CREATE_TEMP. 11.2.0.2 gets the same bytes.
# Captured 2026-11-27 through tools/capture_proxy.py. The TTC payload,
# without the packet's header, as `hexdump -C` output; the offset column
# and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  03 60 03 01 01 28 00 01  0a 00 00 01 00 01 02 01  |.`...(..........|
00000010  10 01 01 01 01 01 01 70  01 00 00 00 00 00 00 00  |.......p........|
00000020  54 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |T...............|
00000030  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000040  00 00 00 00 00 00 00 02  03 69 01 01 01 0a        |.........i....|
0000004e
